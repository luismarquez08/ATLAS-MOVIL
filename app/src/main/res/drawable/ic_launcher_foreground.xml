    </path>

    <!-- Voice / Frequency Core Waves -->
    <path
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF"
        android:pathData="M 46,50 L 46,58 M 50,47 L 50,61 M 54,44 L 54,64 M 58,47 L 58,61 M 62,50 L 62,58" />

    <!-- Four Corner Cyber Nodes / Constellation markers -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M 54,21 L 56,26 L 52,26 Z M 54,87 L 56,82 L 52,82 Z M 21,54 L 26,56 L 26,52 Z M 87,54 L 82,56 L 82,52 Z" />
